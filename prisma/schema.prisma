// Bedah Data - database schema (PostgreSQL)
// Source of truth: context/Brief_Website_Bedah_Data.pdf

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────── Enums ─────────────

enum Role {
  PENELITI
  ADMIN
  TEAM_MEMBER   // Campus: anggota tim
  INSTITUTION_OWNER // Campus: pemilik institusi
}

enum UserType {
  MAHASISWA
  DOSEN
  PENELITI
  INSTITUSI
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PlanTier {
  FREE
  STUDENT
  RESEARCHER
  CAMPUS
}

enum BillingCycle {
  MONTHLY
  YEARLY
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum ProjectStatus {
  IN_PROGRESS // Dalam proses
  COMPLETED   // Selesai
  VALIDATED   // Tervalidasi
}

enum AnalysisMethod {
  DESCRIPTIVE
  VISUALIZATION
  VALIDITY
  RELIABILITY
  PEARSON
  SIMPLE_REGRESSION
  MULTIPLE_REGRESSION
  CLASSICAL_ASSUMPTIONS
}

enum AnalysisStatus {
  RUNNING
  DONE
  FAILED
}

enum ValidationStatus {
  PENDING
  PASSED
  FLAGGED
}

enum VariableType {
  NUMERIC
  CATEGORICAL
  ORDINAL
}

enum MissingStrategy {
  NONE
  DROP_ROWS
  FILL_MEAN
  FILL_MEDIAN
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

// Four separately tracked revenue sources (brief section 5)
enum RevenueSource {
  SUBSCRIPTION
  INSTITUTION_LICENSE
  ADDON
  TRAINING
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum QuoteStatus {
  NEW         // Baru
  CONTACTED   // Dihubungi
  NEGOTIATION // Negosiasi
  DEAL
  CANCELLED   // Batal
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// ───────────── Users & access ─────────────

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  emailVerified  DateTime?
  passwordHash   String
  role           Role       @default(PENELITI)
  userType       UserType   @default(MAHASISWA)
  status         UserStatus @default(ACTIVE)
  isDemo         Boolean    @default(false)
  consentAt      DateTime? // persetujuan UU PDP
  lastActiveAt   DateTime?
  institutionId  String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime? // hapus akun / hapus data

  institution   Institution?   @relation(fields: [institutionId], references: [id])
  subscriptions Subscription[]
  projects      Project[]
  datasets      Dataset[]
  chatMessages  ChatMessage[]
  transactions  Transaction[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  tokens        VerificationToken[]
  feedback      Feedback[]

  @@index([role])
  @@index([createdAt])
  @@index([lastActiveAt])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ───────────── Plans & subscriptions ─────────────

// Limits live in the DB so Admin can change them without a deploy (brief section 5).
// null = unlimited. Enforced server-side.
model Plan {
  tier               PlanTier @id
  name               String
  priceMonthly       Int      @default(0) // IDR
  priceYearly        Int      @default(0) // IDR
  maxProjects        Int?
  maxRows            Int?
  maxChatPerDay      Int?
  // Feature access levels: NONE | LIMITED | FULL
  accessCorrelation  String   @default("FULL") // korelasi, validitas, reliabilitas
  accessSimpleReg    String   @default("FULL")
  accessMultiReg     String   @default("FULL") // berganda + asumsi klasik
  validationLevel    String   @default("FULL") // BASIC | FULL
  exportFormats      String[] @default([]) // ["PDF","DOCX"]
  premiumTemplates   Boolean  @default(false)
  institutionTemplates Boolean @default(false)
  advancedBatch      Boolean  @default(false)
  multiUserDashboard Boolean  @default(false)
  onboarding         Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id            String             @id @default(cuid())
  userId        String
  tier          PlanTier
  cycle         BillingCycle       @default(MONTHLY)
  status        SubscriptionStatus @default(ACTIVE)
  startedAt     DateTime           @default(now())
  renewsAt      DateTime?
  cancelledAt   DateTime?
  promoCodeId   String?
  createdAt     DateTime           @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan  Plan       @relation(fields: [tier], references: [tier])
  promo PromoCode? @relation(fields: [promoCodeId], references: [id])

  @@index([userId, status])
}

model PromoCode {
  id          String         @id @default(cuid())
  code        String         @unique
  percentOff  Int
  maxUses     Int?
  usedCount   Int            @default(0)
  expiresAt   DateTime?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  subscriptions Subscription[]
}

model Transaction {
  id          String        @id @default(cuid())
  userId      String?
  institutionId String?
  source      RevenueSource
  amount      Int // IDR
  status      PaymentStatus @default(PENDING)
  method      String? // QRIS, VA, e-wallet, transfer
  invoiceNo   String?       @unique
  gatewayRef  String?
  isManual    Boolean       @default(false) // dicatat admin
  note        String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  user        User?        @relation(fields: [userId], references: [id])
  institution Institution? @relation(fields: [institutionId], references: [id])

  @@index([source, status])
  @@index([createdAt])
}

// ───────────── Campus / institutions ─────────────

model Institution {
  id            String    @id @default(cuid())
  name          String
  logoUrl       String?
  seats         Int       @default(0)
  contractValue Int? // IDR / year
  startsAt      DateTime?
  endsAt        DateTime?
  isPilot       Boolean   @default(false)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  members      User[]
  transactions Transaction[]
  quotes       QuoteRequest[]
}

model QuoteRequest {
  id              String      @id @default(cuid())
  institutionName String
  userCount       Int
  picName         String
  picContact      String
  status          QuoteStatus @default(NEW)
  institutionId   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  institution Institution? @relation(fields: [institutionId], references: [id])
}

// ───────────── Research workspace ─────────────

model Project {
  id          String        @id @default(cuid())
  ownerId     String
  title       String
  description String?
  hypothesis  String?
  method      AnalysisMethod?
  status      ProjectStatus @default(IN_PROGRESS)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  datasets  Dataset[]
  analyses  AnalysisResult[]
  reports   Report[]
  chat      ChatMessage[]

  @@index([ownerId, status])
}

model Dataset {
  id          String   @id @default(cuid())
  ownerId     String
  projectId   String?
  fileName    String
  fileType    String // csv | xlsx | xls
  fileSize    Int // bytes
  storageKey  String // path / S3 key (never exposed via admin API)
  sheetName   String?
  rowCount    Int
  columnCount Int
  // [{ name, type: VariableType, missing, unique }] - schema only, no values
  variables   Json
  missingCount   Int             @default(0)
  duplicateCount Int             @default(0)
  outlierCount   Int             @default(0)
  missingStrategy MissingStrategy @default(NONE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project  Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  analyses AnalysisResult[]

  @@index([ownerId])
  @@index([projectId])
}

model AnalysisResult {
  id         String         @id @default(cuid())
  projectId  String
  datasetId  String
  method     AnalysisMethod
  status     AnalysisStatus @default(RUNNING)
  params     Json // chosen variables, options
  result     Json? // tables, chart specs, interpretation, warnings
  durationMs Int?
  error      String?
  createdAt  DateTime       @default(now())

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dataset    Dataset     @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  validation Validation?

  @@index([projectId])
  @@index([method])
  @@index([createdAt])
}

// Research Validation Engine: independent recomputation + comparison.
model Validation {
  id         String           @id @default(cuid())
  analysisId String           @unique
  status     ValidationStatus @default(PENDING)
  tolerance  Float            @default(0.000001)
  // [{ check, passed, detail }]: completeness, sample adequacy, assumptions, recomputation
  checks     Json
  // [{ metric, primary, secondary, diff }] when flagged
  discrepancies Json?
  createdAt  DateTime         @default(now())

  analysis AnalysisResult @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model Report {
  id        String   @id @default(cuid())
  projectId String
  title     String
  sections  Json // selected sections + edited text
  template  String   @default("standard")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// ───────────── Platform / admin ─────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. ADMIN_VIEW_DATASET_META, USER_SUSPEND
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  message   String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// Key/value platform settings: demo-account toggle, announcements, FAQ, email templates,
// impact targets (1.500 user, 1.000 MAU, 3 pilot, 2.000 analisis).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

